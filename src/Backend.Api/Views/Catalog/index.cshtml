@using System.Globalization;

@model IReadOnlyList<Backend.Api.DTOs.ProductResponse>

@{
    Layout= null;
    ViewData["Title"] = "Catalog Page";
    var rupiah = CultureInfo.GetCultureInfo("id-ID");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
</head>
<body>
    <table border="1">
        <tr>
            <th>Product Code</th>
            <th>Product</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>

        <tbody>
            @if (Model.Count == 0)
                {
                    <tr>
                        <td>Belum ada Product</td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <th>@product.ProductCode</th>
                            <th>@product.Name</th>
                            <th>@product.Category</th>
                            <th>@product.Price.ToString("C0",rupiah)</th>
                            <th>@product.Stock</th>
                        </tr>
                    }
                }
            </tbody>
    </table>
</body>
</html>